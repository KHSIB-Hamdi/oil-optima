# Copy this file to .env and fill in real values. Never commit .env.

# --- MySQL (local dev defaults shown; the app falls back to these) ---
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=oiloptima_pgs

# --- Flask ---
# Any long random string. Used to sign session cookies.
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# --- Google Gemini (chatbot, /chatbot) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- OpenWeatherMap (logistics route weather) ---
# https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweathermap-api-key-here
